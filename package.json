{
  "name": "card-dispute-portal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "ng": "ng",
    "start": "ng serve",
    "start:dev": "ng serve --configuration development",
    "start:prod": "ng serve --configuration production",
    "build": "ng build --configuration production",
    "build:dev": "ng build --configuration development",
    "build:prod": "ng build --configuration production",
    "generate:api": "openapi-typescript openapi/openapi.yaml -o src/app/generated/api-types.ts",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:types": "tsc --project tsconfig.spec.json --noEmit"
  },
  "dependencies": {
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "@auth0/auth0-angular": "^2.13.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.25",
    "@angular/cli": "21.2.26",
    "@angular/compiler-cli": "21.2.25",
    "jsdom": "27.0.0",
    "openapi-typescript": "7.10.1",
    "prettier": "3.6.2",
    "typescript": "~5.9.2",
    "vitest": "4.0.8"
  }
}
